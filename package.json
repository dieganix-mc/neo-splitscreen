{
  "name": "neo-splitscreen",
  "version": "0.3.0-dev.0",
  "description": "Independent Minecraft Java split-screen development prototype",
  "main": "main.js",
  "author": "Neo Splitscreen contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:native": "cmd /c native\\build.bat",
    "dist": "npm run build:native && electron-builder --win nsis"
  },
  "build": {
    "appId": "app.neo.splitscreen",
    "productName": "Neo Splitscreen",
    "directories": {"output": "dist"},
    "files": ["main.js", "preload.js", "index.html", "style.css", "app.js", "README.md", "LICENSE"],
    "extraResources": [{"from": "native/neo_windows.exe", "to": "neo_windows.exe"}, {"from": "runtime/mouse-mouse/build/libs/Mouse-mouse-Fabric-1.0.2+mc26.2.jar", "to": "neo_input_26.2.jar"}],
    "win": {"target": ["nsis"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true}
  },
  "devDependencies": {"electron": "^44.4.3", "electron-builder": "^26.15.3"}
}
